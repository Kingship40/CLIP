# ClipForge AI - Frontend Configuration

# Set to 'true' to run fully offline with client-side simulation
VITE_ENABLE_DEMO_MODE=true

# When ready to connect to a real Python FastAPI backend, provide the base URL:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=

# Optional: Public S3/Cloud Storage endpoint for pre-signed uploads
VITE_STORAGE_PROVIDER=local
